generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ELEV
  ANTREPRENOR
  ADMIN
}

enum Plan {
  GRATUIT
  PRO
}

enum IdeaStatus {
  PUBLICAT
  CONTACTAT
  IN_COLABORARE
  REALIZAT
}

enum IdeaVisibility {
  PUBLIC
  PRIVAT
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum MessageType {
  TEXT
  PDF
  IMAGE
  EVENT
}

enum GiveawayStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum ReportStatus {
  PENDING
  RESOLVED
}

enum ReportContentType {
  IDEA
  MESSAGE
  USER
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE_NEW
  IDEA_FEEDBACK
  IDEA_PUBLISHED
  GIVEAWAY_NEW
  GIVEAWAY_WON
  GIVEAWAY_RESULT
  COLLAB_CONFIRM
  COLLAB_CONFIRMED
  IDEA_STATUS_RESET
  SUBSCRIPTION_EXPIRING
  ACCOUNT_WARNING
  SYSTEM
  GROUP_MESSAGE
  SUPPORT_MESSAGE
}

enum InvestmentStatus {
  ACTIV
  IN_NEGOCIERE
  FINALIZAT
  NECONFIRMAT
}

enum EntrepreneurStatus {
  ACTIV
  INACTIV
  RETRAS
}

enum ModerationLevel {
  AVERTISMENT
  ELIMINARE_CONTINUT
  SUSPENDARE_CONT
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  plan         Plan     @default(GRATUIT)
  isDeleted    Boolean  @default(false) @map("is_deleted")
  isSuspended  Boolean  @default(false) @map("is_suspended")
  suspendedAt  DateTime? @map("suspended_at")
  suspendReason String?  @map("suspend_reason")
  firstLogin   Boolean  @default(true) @map("first_login")
  createdAt    DateTime @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")
  lastActivity DateTime? @map("last_activity")
  deletedAt    DateTime? @map("deleted_at")
  onboardingComplete Boolean @default(false) @map("onboarding_complete")

  // Relații
  profileElev              ProfileElev?
  profileAntreprenor       ProfileAntreprenor?
  ideas                    Idea[]
  connectionRequestsSent   ConnectionRequest[]   @relation("SentRequests")
  connectionRequestsReceived ConnectionRequest[] @relation("ReceivedRequests")
  conversationsAsA         Conversation[]        @relation("ConversationsAsA")
  conversationsAsB         Conversation[]        @relation("ConversationsAsB")
  messagesSent             Message[]
  feedbackGiven            Feedback[]            @relation("FeedbackGiven")
  collaborationsAsElev     Collaboration[]       @relation("ElevCollaborations")
  collaborationsAsAntreprenor Collaboration[]    @relation("AntreprenorCollaborations")
  giveawaysCreated         Giveaway[]
  giveawayParticipations   GiveawayParticipant[]
  subscriptions            Subscription[]
  notifications            Notification[]
  blocksInitiated          BlockedUser[]         @relation("Blocker")
  blocksReceived           BlockedUser[]         @relation("Blocked")
  reportsSubmitted         Report[]              @relation("Reporter")
  parentalConsent          ParentalConsent?
  investmentHistory        InvestmentHistory[]
  moderationActions        ModerationAction[]    @relation("ModeratedUser")
  adminActions             ModerationAction[]    @relation("AdminActions")
  cookieConsent            CookieConsent?
  dataExportRequests       DataExportRequest[]
  groupsCreated            IdeaGroup[]           @relation("GroupsCreated")
  groupMemberships         IdeaGroupMember[]
  groupMessagesSent        GroupMessage[]
  supportTickets           SupportTicket[]
  supportMessages          SupportMessage[]
  categoriesCreated        Category[]            @relation("CategoriesCreated")

  @@index([email])
  @@index([role])
  @@index([plan])
  @@index([lastActivity])
  @@index([isDeleted])
  @@map("users")
}

// ─────────────────────────────────────────────
// PROFILURI
// ─────────────────────────────────────────────

model ProfileElev {
  userId    String   @id @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  username  String?  @unique
  school    String?
  class     String?
  city      String?
  bio       String?
  interests String[] @default([])
  avatarUrl String?  @map("avatar_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles_elev")
}

model ProfileAntreprenor {
  userId          String              @id @map("user_id")
  firstName       String              @map("first_name")
  lastName        String              @map("last_name")
  username        String?             @unique
  company         String?
  position        String?
  domain          String?
  website         String?
  bioMentor       String?             @map("bio_mentor")
  experienceYears Int?                @map("experience_years")
  avatarUrl       String?             @map("avatar_url")
  status          EntrepreneurStatus  @default(ACTIV)
  statusUpdatedAt DateTime?           @map("status_updated_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("profiles_antreprenor")
}

// ─────────────────────────────────────────────
// IDEI
// ─────────────────────────────────────────────

model Idea {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  title          String
  categories     String[]
  problem        String
  solution       String
  targetAudience String?        @map("target_audience")
  tags           String[]       @default([])
  visibility     IdeaVisibility @default(PUBLIC)
  status         IdeaStatus     @default(PUBLICAT)
  planAtPost     Plan           @map("plan_at_post")
  viewCount      Int            @default(0) @map("view_count")
  wordCount      Int            @default(0) @map("word_count")
  score          Float          @default(0) @map("score")
  lastMessageAt  DateTime?      @map("last_message_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  images               IdeaImage[]
  pdfs                 IdeaPdf[]
  connectionRequests   ConnectionRequest[]
  feedbackList         Feedback[]
  collaborations       Collaboration[]
  giveawayParticipations GiveawayParticipant[]
  investmentHistory    InvestmentHistory[]
  reports              Report[]              @relation("IdeaReports")
  blockedContent       BlockedContent?
  originConversations  Conversation[]        @relation("ConvOriginIdea")
  contextMessages      Message[]             @relation("MessageContextIdea")

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([planAtPost, createdAt])
  @@index([createdAt])
  @@index([score])
  @@map("ideas")
}

model IdeaImage {
  id        String   @id @default(uuid())
  ideaId    String   @map("idea_id")
  url       String
  publicId  String   @map("public_id")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_images")
}

model IdeaPdf {
  id        String   @id @default(uuid())
  ideaId    String   @map("idea_id")
  url       String
  publicId  String   @map("public_id")
  filename  String
  size      Int
  createdAt DateTime @default(now()) @map("created_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("idea_pdfs")
}

model Category {
  id              String   @id @default(uuid())
  name            String   @unique
  iconName        String?  @map("icon_name")
  order           Int      @default(0)
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  createdByUser User? @relation("CategoriesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@map("categories")
}

// ─────────────────────────────────────────────
// CERERI DE CONECTARE
// ─────────────────────────────────────────────

model ConnectionRequest {
  id           String                  @id @default(uuid())
  fromUserId   String                  @map("from_user_id")
  toUserId     String                  @map("to_user_id")
  ideaId       String?                 @map("idea_id")
  status       ConnectionRequestStatus @default(PENDING)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")
  expiresAt    DateTime                @map("expires_at")

  fromUser    User         @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser      User         @relation("ReceivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  idea        Idea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  conversation Conversation?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@index([expiresAt])
  @@map("connection_requests")
}

// ─────────────────────────────────────────────
// CHAT
// ─────────────────────────────────────────────

model Conversation {
  id                  String    @id @default(uuid())
  participantAId      String    @map("participant_a_id")
  participantBId      String    @map("participant_b_id")
  connectionRequestId String    @unique @map("connection_request_id")
  originIdeaId        String?   @map("origin_idea_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  lastMessageAt       DateTime? @map("last_message_at")

  participantA      User              @relation("ConversationsAsA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB      User              @relation("ConversationsAsB", fields: [participantBId], references: [id], onDelete: Cascade)
  connectionRequest ConnectionRequest @relation(fields: [connectionRequestId], references: [id])
  originIdea        Idea?             @relation("ConvOriginIdea", fields: [originIdeaId], references: [id], onDelete: SetNull)
  messages          Message[]
  reports           Report[]          @relation("ConversationReports")

  @@index([participantAId])
  @@index([participantBId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  content        String?
  type           MessageType @default(TEXT)
  fileUrl        String?     @map("file_url")
  fileName       String?     @map("file_name")
  fileSize       Int?        @map("file_size")
  readAt         DateTime?   @map("read_at")
  isAnonymized   Boolean     @default(false) @map("is_anonymized")
  replyToId      String?     @map("reply_to_id")
  ideaId         String?     @map("idea_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")
  idea         Idea?        @relation("MessageContextIdea", fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// FEEDBACK
// ─────────────────────────────────────────────

model Feedback {
  id                   String   @id @default(uuid())
  antreprenorId        String   @map("antreprenor_id")
  ideaId               String   @map("idea_id")
  ratingGeneral        Int      @map("rating_general")
  ratingOriginalitate  Int      @map("rating_originalitate")
  ratingViabilitate    Int      @map("rating_viabilitate")
  ratingPrezentare     Int      @map("rating_prezentare")
  ratingPotential      Int      @map("rating_potential")
  comment              String?
  interestedInCollab   Boolean  @default(false) @map("interested_in_collab")
  isEditable           Boolean  @default(true) @map("is_editable")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  antreprenor User @relation("FeedbackGiven", fields: [antreprenorId], references: [id], onDelete: Cascade)
  idea        Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([antreprenorId, ideaId])
  @@index([ideaId])
  @@map("feedback")
}

// ─────────────────────────────────────────────
// COLABORĂRI
// ─────────────────────────────────────────────

model Collaboration {
  id                     String    @id @default(uuid())
  elevId                 String    @map("elev_id")
  antreprenorId          String    @map("antreprenor_id")
  ideaId                 String    @map("idea_id")
  confirmedByElev        Boolean   @default(false) @map("confirmed_by_elev")
  confirmedByAntreprenor Boolean   @default(false) @map("confirmed_by_antreprenor")
  confirmedAt            DateTime? @map("confirmed_at")
  reminderSentAt         DateTime? @map("reminder_sent_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  elev         User @relation("ElevCollaborations", fields: [elevId], references: [id], onDelete: Cascade)
  antreprenor  User @relation("AntreprenorCollaborations", fields: [antreprenorId], references: [id], onDelete: Cascade)
  idea         Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  investment   InvestmentHistory?

  @@index([elevId])
  @@index([antreprenorId])
  @@index([ideaId])
  @@map("collaborations")
}

// ─────────────────────────────────────────────
// GIVEAWAY
// ─────────────────────────────────────────────

model Giveaway {
  id                    String         @id @default(uuid())
  antreprenorId         String         @map("antreprenor_id")
  title                 String
  description           String
  investmentDescription String         @map("investment_description")
  startDate             DateTime       @map("start_date")
  endDate               DateTime       @map("end_date")
  maxParticipants       Int?           @map("max_participants")
  winnerId              String?        @map("winner_id")
  status                GiveawayStatus @default(ACTIVE)
  selectionLog          Json?          @map("selection_log")
  notifyAll             Boolean        @default(false) @map("notify_all")
  investmentConfirmedByAntreprenor Boolean   @default(false) @map("investment_confirmed_by_antreprenor")
  investmentConfirmedByElev        Boolean   @default(false) @map("investment_confirmed_by_elev")
  investmentConfirmedAt            DateTime? @map("investment_confirmed_at")
  badgeUnfulfilled                 Boolean   @default(false) @map("badge_unfulfilled")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  antreprenor  User                  @relation(fields: [antreprenorId], references: [id], onDelete: Cascade)
  participants GiveawayParticipant[]

  @@index([antreprenorId])
  @@index([status])
  @@index([endDate])
  @@map("giveaways")
}

model GiveawayParticipant {
  id         String   @id @default(uuid())
  giveawayId String   @map("giveaway_id")
  elevId     String   @map("elev_id")
  ideaId     String   @map("idea_id")
  joinedAt   DateTime @default(now()) @map("joined_at")

  giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  elev     User     @relation(fields: [elevId], references: [id], onDelete: Cascade)
  idea     Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, elevId])
  @@index([giveawayId])
  @@index([elevId])
  @@map("giveaway_participants")
}

// ─────────────────────────────────────────────
// ABONAMENTE
// ─────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  plan                 Plan      @default(PRO)
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// NOTIFICĂRI
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// BLOCARE
// ─────────────────────────────────────────────

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

// ─────────────────────────────────────────────
// RAPOARTE
// ─────────────────────────────────────────────

model Report {
  id            String            @id @default(uuid())
  reporterId    String            @map("reporter_id")
  contentType   ReportContentType @map("content_type")
  contentId     String            @map("content_id")
  reason        String
  description   String?
  status        ReportStatus      @default(PENDING)
  resolvedAt    DateTime?         @map("resolved_at")
  resolvedBy    String?           @map("resolved_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  reporter     User  @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  idea         Idea? @relation("IdeaReports", fields: [contentId], references: [id], onDelete: Cascade, map: "fk_report_idea")
  conversation Conversation? @relation("ConversationReports", fields: [contentId], references: [id], onDelete: Cascade, map: "fk_report_conversation")

  @@index([status])
  @@index([contentType, contentId])
  @@index([reporterId])
  @@map("reports")
}

// ─────────────────────────────────────────────
// CONSIMȚĂMÂNT PARENTAL
// ─────────────────────────────────────────────

model ParentalConsent {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  parentEmail  String    @map("parent_email")
  token        String    @unique
  confirmedAt  DateTime? @map("confirmed_at")
  rejectedAt   DateTime? @map("rejected_at")
  reminderSent Boolean   @default(false) @map("reminder_sent")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("parental_consents")
}

// ─────────────────────────────────────────────
// INVESTIȚII
// ─────────────────────────────────────────────

model InvestmentHistory {
  id               String           @id @default(uuid())
  antreprenorId    String           @map("antreprenor_id")
  ideaId           String           @map("idea_id")
  collaborationId  String?          @unique @map("collaboration_id")
  investmentType   String           @map("investment_type")
  amountDescription String?         @map("amount_description")
  status           InvestmentStatus @default(ACTIV)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  antreprenor   User           @relation(fields: [antreprenorId], references: [id], onDelete: Cascade)
  idea          Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)

  @@index([antreprenorId])
  @@index([ideaId])
  @@index([status])
  @@map("investment_history")
}

// ─────────────────────────────────────────────
// MODERARE
// ─────────────────────────────────────────────

model ModerationAction {
  id          String          @id @default(uuid())
  adminId     String          @map("admin_id")
  targetId    String          @map("target_id")
  level       ModerationLevel
  reason      String
  contentRef  String?         @map("content_ref")
  createdAt   DateTime        @default(now()) @map("created_at")

  admin  User @relation("AdminActions", fields: [adminId], references: [id])
  target User @relation("ModeratedUser", fields: [targetId], references: [id])

  @@index([targetId])
  @@index([adminId])
  @@map("moderation_actions")
}

model BlockedContent {
  id        String   @id @default(uuid())
  ideaId    String   @unique @map("idea_id")
  reason    String
  reportCount Int    @default(0) @map("report_count")
  hiddenAt  DateTime @default(now()) @map("hidden_at")

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@map("blocked_content")
}

// ─────────────────────────────────────────────
// GDPR / LEGAL
// ─────────────────────────────────────────────

model CookieConsent {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  essential   Boolean  @default(true)
  analytics   Boolean  @default(true)
  marketing   Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cookie_consents")
}

model DataExportRequest {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  format      String    @default("JSON")
  status      String    @default("PENDING")
  fileUrl     String?   @map("file_url")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_export_requests")
}

// Full-text search vector pentru idei
// Index creat prin migrație SQL custom:
// CREATE INDEX ideas_fts ON ideas USING GIN(to_tsvector('romanian', title || ' ' || problem || ' ' || solution));

// ─────────────────────────────────────────────
// GRUPURI DE ELEVI
// ─────────────────────────────────────────────

model IdeaGroup {
  id            String    @id @default(uuid())
  name          String
  avatarUrl     String?   @map("avatar_url")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastMessageAt DateTime? @map("last_message_at")

  createdBy User             @relation("GroupsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  members   IdeaGroupMember[]
  messages  GroupMessage[]

  @@index([createdById])
  @@map("idea_groups")
}

model IdeaGroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now()) @map("joined_at")

  group IdeaGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("idea_group_members")
}

model GroupMessage {
  id        String      @id @default(uuid())
  groupId   String      @map("group_id")
  senderId  String      @map("sender_id")
  content   String?
  type      MessageType @default(TEXT)
  fileUrl   String?     @map("file_url")
  replyToId String?     @map("reply_to_id")
  createdAt DateTime    @default(now()) @map("created_at")

  group   IdeaGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo GroupMessage?  @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies GroupMessage[] @relation("GroupMessageReplies")

  @@index([groupId, createdAt])
  @@index([senderId])
  @@map("group_messages")
}

// ─────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────

model SupportTicket {
  id         String    @id @default(uuid())
  name       String
  email      String
  message    String?
  userId     String?   @unique @map("user_id")
  status     String    @default("OPEN")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  senderId  String?  @map("sender_id")
  isAdmin   Boolean  @default(false) @map("is_admin")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
