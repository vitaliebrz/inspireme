# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/inspireme?schema=public"

# ─────────────────────────────────────────────
# Redis — Upstash (rediss:// = TLS, port 6380)
# Format: rediss://default:TOKEN@HOST:6380
# ─────────────────────────────────────────────
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6380
UPSTASH_REDIS_REST_URL=https://HOST.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────
# JWT — generează cu: openssl rand -base64 64
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─────────────────────────────────────────────
# Cloudinary
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Prețuri Stripe (obținute din dashboard după creare)
STRIPE_PRICE_ELEV_PRO_LUNAR=price_
STRIPE_PRICE_ELEV_PRO_ANUAL=price_
STRIPE_PRICE_ANTREPRENOR_PRO_LUNAR=price_
STRIPE_PRICE_ANTREPRENOR_PRO_ANUAL=price_

# ─────────────────────────────────────────────
# Resend (email)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_URL=http://localhost:4000
DPO_EMAIL=dpo@inspireme.ro
