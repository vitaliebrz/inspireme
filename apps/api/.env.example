# ─── Baza de date ───────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/inspireme?sslmode=require"

# ─── Redis (Upstash) ────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ─── JWT ────────────────────────────────────
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"

# ─── Cloudinary ─────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Stripe ─────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_ELEV_MONTHLY_PRICE_ID="price_..."
STRIPE_ELEV_YEARLY_PRICE_ID="price_..."
STRIPE_ANTREPRENOR_MONTHLY_PRICE_ID="price_..."
STRIPE_ANTREPRENOR_YEARLY_PRICE_ID="price_..."

# ─── Resend (email) ─────────────────────────
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@inspireme.ro"

# ─── App ─────────────────────────────────────
APP_URL="http://localhost:5173"
PORT=4000
NODE_ENV=development
