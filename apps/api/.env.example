# ─── App ─────────────────────────────────────
NODE_ENV=development
PORT=4000
# URL-ul frontend-ului: CORS + link-urile din emailuri
FRONTEND_URL="http://localhost:5173"
# URL-ul frontend-ului pentru redirect-urile Stripe Checkout (de obicei = FRONTEND_URL)
APP_URL="http://localhost:5173"
# Câte proxy-uri stau în fața API-ului (pentru IP-ul real în rate limiting).
# 0 = local/direct; 2 = producție (Netlify + Render)
TRUST_PROXY_HOPS=0
# Opțional: trace | debug | info | warn | error (implicit info)
LOG_LEVEL=info

# ─── Baza de date ───────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/inspireme?sslmode=require"

# ─── Redis (Upstash) ────────────────────────
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ─── JWT (min. 32 caractere, diferite între ele) ─
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"

# ─── Cloudinary ─────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Stripe ─────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_ELEV_MONTHLY_PRICE_ID="price_..."
STRIPE_ELEV_YEARLY_PRICE_ID="price_..."
STRIPE_ANTREPRENOR_MONTHLY_PRICE_ID="price_..."
STRIPE_ANTREPRENOR_YEARLY_PRICE_ID="price_..."

# ─── Email ──────────────────────────────────
# Ordinea de prioritate: Mailtrap → Gmail → Brevo → Resend.
# Dacă MAILTRAP_* e completat, TOATE emailurile ajung în sandbox-ul Mailtrap (doar dev!).
# Pe Render Free porturile SMTP sunt blocate → Gmail/Mailtrap nu merg acolo; folosește Brevo.

# Brevo (producție, fără domeniu propriu) — expeditorul trebuie verificat în Brevo → Senders
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# Resend (necesită domeniu verificat pentru a trimite către oricine)
RESEND_API_KEY="re_..."
RESEND_FROM="InspireMe <noreply@inspireme.ro>"

# Gmail (opțional) — necesită App Password, nu parola contului
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Mailtrap sandbox (opțional, doar development)
MAILTRAP_HOST=""
MAILTRAP_PORT=2525
MAILTRAP_USER=""
MAILTRAP_PASS=""
