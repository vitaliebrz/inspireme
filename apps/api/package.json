{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "InspireMe API — Express + TypeScript + Prisma + PostgreSQL + Redis",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "cleanup:cloudinary": "tsx --env-file .env scripts/cleanup-cloudinary.ts",
    "cleanup:cloudinary:dry": "tsx --env-file .env scripts/cleanup-cloudinary.ts --dry-run"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/nodemailer": "^8.0.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^4.1.2",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
