# Ambele sunt opționale în development: fără ele, frontend-ul folosește
# http://<host-ul curent>:4000/api/v1 (merge și de pe telefon în rețeaua locală).
# În producție sunt setate în netlify.toml.

# URL-ul API (cu /api/v1, fără / la final). Poate fi relativ: "/api/v1"
VITE_API_URL="http://localhost:4000/api/v1"

# Originea serverului Socket.io (fără cale). Implicit: originea lui VITE_API_URL
VITE_SOCKET_URL="http://localhost:4000"
